{
  "manifest_version": 3,
  "name": "Tilt Up - Tiny Arcade Climb",
  "short_name": "Tilt Up",
  "version": "1.2.0",
  "description": "Tilt the bar, roll the ball past the holes, sink the lit pocket. Daily challenge and shareable level seeds.",
  "action": {
    "default_title": "Tilt Up",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
