# Copy to .env (git-ignored) to run `npm run publish:store` / `npm run status` from this machine.
# In GitHub, add the same names as repository secrets instead. See docs/RELEASING.md.
CWS_PUBLISHER_ID=
CWS_ITEM_ID=
# Either a service account key (whole JSON on one line) ...
CWS_SERVICE_ACCOUNT_JSON=
# ... or an OAuth client + refresh token.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
